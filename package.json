{
  "name": "aceleralock-app",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx tests/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json}\"",
    "test:kotlin": "gradle -p native/modules/aceleralock-blocker :core:test",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "aceleralock-blocker": "file:./native/modules/aceleralock-blocker",
    "expo": "57.0.18",
    "expo-constants": "57.0.16",
    "expo-dev-client": "57.0.16",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "57.0.8",
    "expo-router": "57.0.17",
    "expo-splash-screen": "57.0.8",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "6.0.3"
  }
}
