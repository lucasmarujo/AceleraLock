{
  "expo": {
    "name": "AceleraLock",
    "slug": "aceleralock",
    "scheme": "aceleralock",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": ["ios", "android"],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/png/ios/icon-1024.png",
    "ios": {
      "bundleIdentifier": "com.aceleralock.app",
      "supportsTablet": false,
      "entitlements": {
        "com.apple.developer.family-controls": true
      }
    },
    "android": {
      "package": "com.aceleralock.app",
      "allowBackup": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#04141c",
        "backgroundImage": "./assets/png/android/adaptive/background-1024.png",
        "foregroundImage": "./assets/png/android/adaptive/foreground-1024.png",
        "monochromeImage": "./assets/png/mark/lock-solid-white-1024.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F7F8",
          "image": "./assets/png/android/adaptive/foreground-1024.png",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#04141c",
            "image": "./assets/png/android/adaptive/foreground-1024.png"
          }
        }
      ],
      "./native/plugins/withAceleralockBlocker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
